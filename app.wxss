page {
  --primary: #667eea;
  --primary-dark: #764ba2;
  --success: #28a745;
  --danger: #dc3545;
  --warning: #ffc107;
  --gray: #6c757d;
  --light: #f8f9fa;
  --dark: #343a40;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.container {
  padding: 20rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-sizing: border-box;
}

.card {
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

/* 按钮样式 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 40rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.btn-success {
  background: var(--success);
  color: white;
}

.btn-danger {
  background: var(--danger);
  color: white;
}

.btn-outline {
  background: white;
  border: 2rpx solid var(--primary);
  color: var(--primary);
}

.btn-sm {
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}

/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.tag-primary {
  background: #f0f0ff;
  color: var(--primary);
  border: 1rpx solid var(--primary);
}

.tag-success {
  background: #d4edda;
  color: #155724;
}

.tag-warning {
  background: #fff3cd;
  color: #856404;
}

/* 输入框样式 */
.input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

/* 动画 */
@keyframes pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7);
  }
  50% {
    box-shadow: 0 0 0 20rpx rgba(220, 53, 69, 0);
  }
}

.recording {
  animation: pulse 1s infinite;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
  color: #999;
  font-size: 28rpx;
}

/* 笔记项 */
.note-item {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border-left: 8rpx solid var(--primary);
}

.note-item.processed {
  border-left-color: var(--success);
  background: #f0f9f0;
  opacity: 0.85;
}

/* Flex 布局 */
.flex {
  display: flex;
}

.flex-1 {
  flex: 1;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.gap-2 {
  gap: 16rpx;
}

.gap-3 {
  gap: 24rpx;
}

/* 间距 */
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.p-3 { padding: 24rpx; }

/* 文字 */
.text-sm { font-size: 24rpx; }
.text-base { font-size: 28rpx; }
.text-lg { font-size: 32rpx; }
.text-gray { color: #666; }
.text-muted { color: #999; }
